<script>
// Load related articles
fetch('/blog/articles.json').then(function(r){return r.json()}).then(function(arts){
  var slug = 'shopify-vs-woocommerce-arab-platform';
  var cat = 'store';
  var related = arts.filter(function(a){return a.slug !== slug && a.category === cat}).slice(0,3);
  if(related.length > 0){
    document.getElementById('relatedSection').style.display = 'block';
    document.getElementById('relatedGrid').innerHTML = related.map(function(a){
      return '<a href="/blog/'+a.slug+'" class="rel-card"><div class="rel-cat">'+a.category+'</div><div class="rel-title">'+a.title+'</div></a>';
    }).join('');
  }
}).catch(function(){});
</script>
